{% extends "base.html.j2" %}
{% macro eyebrow(text) -%}
<span class="eyebrow"><span class="eyebrow__line" aria-hidden="true"></span>{{ text }}</span>
{%- endmacro %}
{% macro topic_card(topic, label, more) -%}
<li class="topic-card">
  <span class="topic-card__meta"><span class="topic-card__badge">{{ label }}</span><span class="topic-card__id">{{ topic.id }}</span></span>
  <h4 class="topic-card__title">{{ topic.title }}</h4>
  <p class="topic-card__body">{{ topic.body }}</p>
  <a class="topic-card__link" href="{{ topic.href }}" aria-label="{{ more }}: {{ topic.title }}">{{ more }} →</a>
</li>
{%- endmacro %}
{% block scripts %}
  <script type="module" src="{{ asset_url('/assets/js/engagement.js') }}"></script>
{%- endblock %}
{% block main %}
    <section id="top" class="hero container">
      <div class="hero__meta mono">
        <span><span class="accent" aria-hidden="true">●</span> Charalambos Emmanouilidis · OSCP</span>
        <span>{{ t.hero.focus }}</span>
        <span>{{ t.hero.loc }}</span>
      </div>
      <h1 class="hero__title">{{ t.hero.h1a }}<span class="hero__title-accent">{{ t.hero.h1b }}</span></h1>
      <p class="hero__lead">{{ t.hero.lead }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="mailto:{{ site.contact_email }}?subject={{ t.hero.mail_subject | urlencode }}">{{ t.hero.cta }}</a>
      </div>
    </section>

    <section class="profile" aria-label="{{ t.a11y.profile }}">
      <dl class="profile__grid container mono">
        {%- for item in t.profile %}
        <div class="profile__item"><dt>{{ item.key }}</dt><dd>{{ item.value }}</dd></div>
        {%- endfor %}
      </dl>
    </section>

    <section id="leistungen" class="services container">
      <div class="section-head">
        {{ eyebrow(t.services.eyebrow) }}
        <h2 class="section-title">{{ t.services.title }}</h2>
      </div>
      <div class="services__grid">
        {%- for s in t.services["items"] %}
        <article class="service">
          <span class="service__tag">{{ s.tag }}</span>
          <h3 class="service__title">{{ s.title }}</h3>
          <p class="service__body">{{ s.body }}</p>
        </article>
        {%- endfor %}
      </div>
    </section>

    <section id="fallbeispiel" class="approach">
      <div class="approach__intro container">
        <div class="approach__head">
          {{ eyebrow(t.approach.eyebrow) }}
          <h2 class="section-title">{{ t.approach.title_a }}<span class="accent">{{ t.approach.title_b }}</span></h2>
        </div>
        <div class="approach__text">
          <p class="approach__lead">{{ t.approach.lead }}</p>
        </div>
      </div>

      {#- Without JavaScript the stage shows phase 1 with its full command, spec 010 #}
      {%- set first = engagement.steps[0] %}
      {%- set phase_total = '%02d' % (engagement.steps | length) %}
      <div class="walk" data-engagement>
        <script type="application/json" data-engagement-data>{{ engagement | tojson }}</script>
        <canvas class="walk__canvas" data-canvas role="img" aria-label="{{ t.engagement.aria }}"></canvas>
        <div class="walk__over">
          <span class="walk__phase"><span data-phase-no>{{ t.engagement.phase }} 01 / {{ phase_total }}</span><span class="walk__mode walk__mode--{{ first.mode }}" data-mode>{{ t.engagement.modes[first.mode] }}</span></span>
          <div class="walk__titles">
            <span class="walk__title" data-title>{{ first.title }}</span>
            <span class="walk__hit" data-hit>{{ first.hit }}</span>
          </div>
          <div class="walk__cmd"><span class="accent">❯ </span><span data-cmd>{{ first.cmd }}</span><span class="walk__cursor" aria-hidden="true">▌</span></div>
        </div>
        <ol class="walk__rail" aria-label="{{ t.engagement.phases_label }}">
          {%- for step in engagement.steps %}
          <li class="walk__rail-item">
            <button type="button" class="walk__rail-btn" data-rail aria-label="{{ t.engagement.phase }} {{ loop.index }}: {{ step.rail }}"{% if loop.first %} aria-current="step"{% endif %}>
              <span class="walk__track"><span class="walk__fill walk__fill--{{ step.mode }}" data-fill></span></span>
              <span class="walk__rail-label">{{ step.rail }}</span>
            </button>
          </li>
          {%- endfor %}
        </ol>
      </div>

      <div class="approach__note container">{{ t.approach.note }}</div>
    </section>

    <section id="ablauf" class="process">
      <div class="process__inner container">
        <div class="section-head">
          <span class="eyebrow eyebrow--light">{{ t.process.eyebrow }}</span>
          <h2 class="section-title section-title--light">{{ t.process.title }}</h2>
        </div>
        <ol class="process__steps">
          {%- for st in t.process.steps %}
          <li class="process__step">
            <span class="process__n">{{ st.n }}</span>
            <h3 class="process__title">{{ st.title }}</h3>
            <p class="process__body">{{ st.body }}</p>
          </li>
          {%- endfor %}
        </ol>
      </div>
    </section>

    <section class="toolbox container" aria-labelledby="warum">
      <div class="toolbox__intro">
        {{ eyebrow(t.toolbox.eyebrow) }}
        <h2 id="warum" class="section-title">{{ t.toolbox.title }}</h2>
        <p class="toolbox__lead">{{ t.toolbox.lead }}</p>
      </div>
      <div class="toolbox__groups">
        {%- for g in tools %}
        <div class="toolbox__group">
          <h3 class="toolbox__label">{{ g.label }}</h3>
          <ul class="toolbox__items">
            {%- for item in g["items"] %}
            <li class="chip{% if g.hot %} chip--hot{% endif %}">{{ item }}</li>
            {%- endfor %}
          </ul>
        </div>
        {%- endfor %}
      </div>
    </section>

    <section id="wissen" class="knowledge" aria-labelledby="wissen-h">
      <div class="knowledge__inner container">
        <div class="knowledge__head">
          <div class="knowledge__title-block">
            <span class="knowledge__eyebrow">
              <span class="pill">{% include "book-icon.svg.j2" %}{{ t.knowledge.badge }}</span>
              <span>{{ t.knowledge.eyebrow }}</span>
            </span>
            <h2 id="wissen-h" class="section-title section-title--dark">{{ t.knowledge.title }}</h2>
          </div>
          <p class="knowledge__lead">{{ t.knowledge.lead }}</p>
        </div>

        {%- for group in featured_groups %}
        <div class="topic-group">
          <div class="topic-group__head">
            <h3 class="topic-group__title">{{ group.title }}</h3>
            <span class="topic-group__sub">{{ group.sub }}</span>
          </div>
          <ul class="topic-grid topic-grid--home">
            {%- for topic in group["items"] %}
            {{ topic_card(topic, t.knowledge.badge, t.knowledge.more) }}
            {%- endfor %}
          </ul>
        </div>
        {%- endfor %}

        <div class="knowledge__footer">
          <p class="knowledge__note">{{ t.knowledge.note }}</p>
          <a class="btn btn--light" href="{{ overview_href }}">{{ t.knowledge.all }} →</a>
        </div>
      </div>
    </section>

{% include "cta.html.j2" %}
{%- endblock %}
