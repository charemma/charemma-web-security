{% extends "base.html.j2" %}
{% block title %}404 · {{ t.not_found.title }}{% endblock %}
{% block robots %}
  <meta name="robots" content="noindex">{% endblock %}
{% block main %}
    <section class="hero container">
      <p class="hero__meta mono"><span class="accent">❯</span> HTTP/1.1 404 Not Found</p>
      {%- for entry in translations %}
      <div class="not-found" lang="{{ entry.lang }}">
        <h1 class="not-found__title">{{ entry.t.not_found.title }}</h1>
        <p>{{ entry.t.not_found.body }} <a href="{{ entry.home }}">{{ entry.t.not_found.back }}</a></p>
      </div>
      {%- endfor %}
    </section>
{% endblock %}
