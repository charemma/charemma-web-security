{% extends "base.html.j2" %}
{% block title %}{{ topic.title }} · {{ t.overview.title }} · {{ site_host }}{% endblock %}
{% block description %}{{ article.lead }}{% endblock %}
{% block body_class %}page-light{% endblock %}
{% block nav_links %}{% endblock %}
{%- block scripts %}
{%- if article.has_scene %}
  <script type="module" src="/assets/js/player.js"></script>
{%- endif %}
{%- endblock %}
{% block main %}
    <article class="article container">
      <div class="article__head">
        <a class="overview__back" href="{{ overview_href }}">{{ t.article.back }}</a>
        <span class="knowledge__eyebrow">
          <span class="pill">{% include "book-icon.svg.j2" %}{{ t.knowledge.badge }}</span>
          <span>{{ group_title }} · {{ topic.id }}</span>
        </span>
        <h1 class="overview__title">{{ topic.title }}</h1>
        <p class="overview__lead">{{ article.lead }}</p>
        <p class="article__updated">{{ t.article.updated }} <time datetime="{{ article.updated }}">{{ article.updated }}</time></p>
      </div>
      <div class="article__body">
{{ article.body_html | safe }}      </div>
      {%- if article.has_scene %}
      <div class="anim-i18n" hidden
        data-play="{{ t.article.animation.play }}"
        data-pause="{{ t.article.animation.pause }}"
        data-replay="{{ t.article.animation.replay }}"
        data-chapters="{{ t.article.animation.chapters }}"
        data-variants="{{ t.article.animation.variants }}"
        data-illustration="{{ t.article.animation.illustration }}"
        data-raw-show="{{ t.article.animation.raw_show }}"
        data-raw-hide="{{ t.article.animation.raw_hide }}"></div>
      {%- endif %}
      {%- if article.sources %}
      <section class="article__sources">
        <h2>{{ t.article.sources }}</h2>
        <ol>
          {%- for source in article.sources %}
          <li>{% if "url" in source %}<a href="{{ source.url }}">{{ source.label }}</a>{% else %}{{ source.label }}{% endif %}</li>
          {%- endfor %}
        </ol>
      </section>
      {%- endif %}
    </article>
{% include "cta.html.j2" %}
{%- endblock %}
